{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeerMine",
  "version": "0.2.2",
  "identifier": "com.peermine.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PeerMine — Túnel P2P Minecraft",
        "width": 880,
        "height": 700,
        "minWidth": 640,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws://127.0.0.1:*; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
